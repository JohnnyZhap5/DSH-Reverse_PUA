    "name": "johnnyzhap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnnyZhap5/DSH-Reverse_PUA.git"
  },
  "homepage": "https://github.com/JohnnyZhap5/DSH-Reverse_PUA#readme",
  "bugs": {
    "url": "https://github.com/JohnnyZhap5/DSH-Reverse_PUA/issues"
  }
}
